{
  "compilerOptions": {
    "outDir": "./public/build/",  // ./ -> ./public
    "noImplicitAny": true,
    "module": "commonjs",
    "target": "es6",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "allowJs": true,
    "skipLibCheck": true  // skip for confliction within lib
  },
  "include": ["./src/**/*"]
}
